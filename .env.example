# Compose host port. Optional; default: 18889.
HOST_PORT=18889
# Container HTTP port. Optional; default: 8080.
PORT=8080
# Required for protected APIs and panel access. Generate with: openssl rand -hex 32
API_ACCESS_TOKEN=
# Optional config path; by default the app loads config/config.yaml when present,
# otherwise it loads config/config.example.yaml.
DRAMA_WARDEN_CONFIG=
# Rust child process plugins can be configured under plugins.commands in config/config.yaml.
# DRAMA_WARDEN_PLUGIN_COMMANDS may override that YAML list with JSON.
# Plugin credentials use DRAMA_WARDEN_PLUGIN_<PLUGIN_ID>_<FIELD_KEY>; see docs/PROVIDERS.md.

# Optional MCP process switch. Leave false unless launching the stdio MCP bridge.
ENABLE_MCP=false
# API origin used by the CLI and optional MCP process.
DRAMA_WARDEN_API_URL=http://127.0.0.1:18889

# Database credentials. Non-secret driver and connection settings belong in config/config.yaml.
# This password is required only when DB_DRIVER=mysql; it is also used by the bundled MySQL service.
MYSQL_PASSWORD=
# Required by the bundled MySQL service when using `docker compose --profile mysql up`.
MYSQL_ROOT_PASSWORD=

# Optional TMDB v3 API key. TVmaze works without credentials.
TMDB_API_KEY=
# Optional OpenSubtitles developer API key.
OPENSUBTITLES_API_KEY=

# Optional Feishu bot credentials.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# Optional event endpoint; when set, status notifications use it instead of Feishu.
UPDATE_EVENT_WEBHOOK_URL=
UPDATE_EVENT_WEBHOOK_TOKEN=
# Optional CloudSaver resource search credentials.
CLOUDSAVER_URL=
CLOUDSAVER_USER=
CLOUDSAVER_PASS=
# Optional public WPS query application URL; defaults to the published project application.
WPS_QUERY_URL=https://web.wps.cn/etapps/query/q/ki7rF3kM
# Optional SmartStrm webhook token; configure its non-secret URL and task in config/config.yaml.
SMARTSTRM_WEBHOOK_TOKEN=

# Optional cloud CLI image builds. Review THIRD-PARTY-NOTICES.md before enabling.
INCLUDE_115_CLI=false
INCLUDE_QUARK_CLI=false
# Optional 115 Cookie. Import once for authorization, then remove it from this file.
PAN115_COOKIE=
# Optional existing CLI authorization volumes. Enable external=true only when
# the named Docker volume already exists and is intended to be reused.
QUARK_AUTH_VOLUME=drama-warden-quark-auth
QUARK_AUTH_EXTERNAL=false
PAN115_AUTH_VOLUME=drama-warden-115-auth
PAN115_AUTH_EXTERNAL=false
# Use a custom home only when existing provider auth state lives there.
PLUGIN_HOME=/app/data

# Host directory mounted read-only as local share input. Optional; default: ./data/shares.
LOCAL_STORAGE_SHARE_ROOT_HOST=./data/shares
